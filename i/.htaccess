# 图片存储目录安全加固:禁止任何脚本执行,只作为静态图片服务
<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|phar|cgi|pl|py|sh|asp|aspx|jsp)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 移除PHP处理器(部分空间不支持,FilesMatch兜底)
<IfModule mod_php5.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>

# 始终以图片Content-Type返回,防止浏览器把内容当HTML渲染
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
